# Copy to .env.local for local dev, and add the same values in Vercel → Settings → Environment Variables.

# Supabase (Project Settings → API). Safe to expose to the browser; RLS protects the data.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Server only (Vercel functions). Never prefix these with VITE_.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
GEMINI_API_KEY=...            # Google AI Studio (free tier)
KAKAO_REST_API_KEY=...        # Kakao Developers → 앱 키 → REST API 키 (Korean places)
# GEMINI_MODEL=gemini-2.5-flash   # optional: pin a model if the default name stops working

# 真实地铁 / 公交时间（ODsay，lab.odsay.com）：Web 用的 key，限定 tripaa-go.vercel.app。没有就用直线距离估算。
VITE_ODSAY_KEY=
