# Copy to .env.local for local dev, and add the same values in Vercel → Settings → Environment Variables.

# Supabase (Project Settings → API). Both are safe to expose to the browser; RLS protects the data.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Server only (Vercel function). Never prefix with VITE_.
ANTHROPIC_API_KEY=sk-ant-...
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
