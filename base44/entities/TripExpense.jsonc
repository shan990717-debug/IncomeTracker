{
  "name": "TripExpense",
  "type": "object",
  "properties": {
    "trip_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "food",
        "transport",
        "stay",
        "tickets",
        "shopping",
        "other"
      ],
      "default": "other"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "amount": {
      "type": "number",
      "description": "Amount in the currency it was paid in",
      "default": 0
    },
    "currency": {
      "type": "string",
      "default": "MYR"
    },
    "exchange_rate": {
      "type": "number",
      "description": "1 unit of currency = exchange_rate units of the trip base currency",
      "default": 1
    },
    "amount_base": {
      "type": "number",
      "description": "amount converted to the trip base currency",
      "default": 0
    },
    "paid_by": {
      "type": "string",
      "description": "Participant id who paid"
    },
    "split_type": {
      "type": "string",
      "enum": [
        "equal",
        "custom"
      ],
      "default": "equal"
    },
    "split_among": {
      "type": "array",
      "description": "Participant ids sharing the cost (equal split)",
      "items": { "type": "string" }
    },
    "custom_shares": {
      "type": "array",
      "description": "Per-person share in base currency (custom split)",
      "items": {
        "type": "object",
        "properties": {
          "participant_id": { "type": "string" },
          "amount_base": { "type": "number" }
        }
      }
    },
    "receipt_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "trip_id",
    "title",
    "amount",
    "paid_by"
  ]
}
