{
  "name": "Trip",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "destination": {
      "type": "string"
    },
    "emoji": {
      "type": "string",
      "default": "✈️"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "base_currency": {
      "type": "string",
      "description": "Currency the budget and balances are kept in, e.g. MYR",
      "default": "MYR"
    },
    "budget": {
      "type": "number",
      "description": "Target trip budget in base_currency",
      "default": 0
    },
    "participants": {
      "type": "array",
      "description": "People on the trip. email is set once the person joins with the share link.",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "email": { "type": "string" }
        }
      }
    },
    "member_emails": {
      "type": "array",
      "description": "Logged-in users who can see and edit this trip",
      "items": { "type": "string" }
    },
    "share_code": {
      "type": "string",
      "description": "Code used in the invite link /trips/join/:code"
    },
    "is_archived": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "base_currency"
  ]
}
