{
  "name": "TripSettlement",
  "type": "object",
  "properties": {
    "trip_id": {
      "type": "string"
    },
    "from_participant": {
      "type": "string",
      "description": "Participant id who paid back"
    },
    "to_participant": {
      "type": "string",
      "description": "Participant id who received the money"
    },
    "amount_base": {
      "type": "number",
      "default": 0
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "trip_id",
    "from_participant",
    "to_participant",
    "amount_base"
  ]
}
